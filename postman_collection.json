      "name": "Géneros",
      "description": "CRUD completo del recurso /generos, más los casos de error.",
      "item": [
        {
          "name": "1. Crear género",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Rock {{$randomInt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/generos",
              "host": ["{{baseUrl}}"],
              "path": ["generos"]
            },
            "description": "Devuelve 201 Created. Guarda el id devuelto en la variable {{generoId}} para los casos siguientes."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('generoId', body.id); }",
                  "",
                  "pm.test('devuelve id y nombre', function () {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.nombre).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
