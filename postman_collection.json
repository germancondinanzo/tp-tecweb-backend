                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('bandaId', body.id); }",
                  "",
                  "pm.test('devuelve los datos de la banda', function () {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.nombre).to.be.a('string');",
                  "    pm.expect(body.pais).to.be.a('string');",
                  "    pm.expect(body.anioFormacion).to.be.a('number');",
                  "    pm.expect(body.generoId).to.be.a('number');",
                  "});"
                ]
              }
            }
