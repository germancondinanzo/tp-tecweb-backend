            "url": {
              "raw": "{{baseUrl}}/bandas",
              "host": ["{{baseUrl}}"],
              "path": ["bandas"]
            },
            "description": "Devuelve 201 Created con los datos de la banda (sin el género anidado: el género llega en los GET, que sí piden la relación). Guarda el id en {{bandaId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () {",
