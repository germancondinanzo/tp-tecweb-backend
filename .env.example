# Valores de ejemplo para desarrollo local (coinciden con docker-compose.yml).
# Copiar este archivo a .env y ajustar si hace falta. El .env real no se versiona.

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret123!
